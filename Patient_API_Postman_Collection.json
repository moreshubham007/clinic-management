{
  "info": {
    "name": "Patient API Collection",
    "description": "Collection for testing Patient API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Patient Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"shubham@vellichormedia.com\",\n  \"password\": \"shubham@vellichormedia.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patient/login",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.environment.set('token', response.token);",
                  "    console.log('Token saved to environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Patient Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "profile"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Get All Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/appointments",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments"]
            }
          },
          "response": []
        },
        {
          "name": "Get Appointments by Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/appointments?status=scheduled",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments"],
              "query": [
                {
                  "key": "status",
                  "value": "scheduled"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create New Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor\": {\n    \"id\": 4\n  },\n  \"datetime\": \"2025-01-20 14:00\",\n  \"notes\": \"Follow-up consultation\",\n  \"patient_type\": \"existing\",\n  \"priority\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patient/appointments",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments"]
            }
          },
          "response": []
        },
        {
          "name": "Get Appointment Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/appointments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Update Appointment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datetime\": \"2025-01-20 15:00\",\n  \"notes\": \"Updated consultation notes\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patient/appointments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/appointments/1",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Get Upcoming Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/appointments/upcoming?days=7",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments", "upcoming"],
              "query": [
                {
                  "key": "days",
                  "value": "7"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Appointment History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/appointments/history?limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "appointments", "history"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Get Available Doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/doctors",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "doctors"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cases",
      "item": [
        {
          "name": "Get Patient Cases",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/cases",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "cases"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Questions",
      "item": [
        {
          "name": "Get Patient Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/patient/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "questions"]
            }
          },
          "response": []
        },
        {
          "name": "Ask New Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor\": {\n    \"id\": 4\n  },\n  \"question\": \"What are the side effects of the medication?\",\n  \"is_private\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patient/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "questions"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Submit Feedback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor\": {\n    \"id\": 4\n  },\n  \"rating\": 5,\n  \"comment\": \"Excellent service and very professional doctor.\",\n  \"is_anonymous\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patient/feedback",
              "host": ["{{base_url}}"],
              "path": ["api", "patient", "feedback"]
            }
          },
          "response": []
        }
      ]
    }
  ]
} 